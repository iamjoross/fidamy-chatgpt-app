# Fidamy API configuration
FIDEMY_BASE_URL=https://api.example.com
FIDEMY_API_KEY=replace-with-your-fidamy-api-key

# Optional request timeout in seconds
FIDEMY_TIMEOUT_SECONDS=10

# Optional MCP DNS rebinding allowlists for tunnels such as ngrok.
# Leave blank for local development without DNS rebinding protection.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
